/* ---------- Prüfungsmodus ---------- */
const EXAM_TARGET=80, EXAM_MIN=150*60;
let exam=null,timerId=null;

function genExam(){
  const byT={}; THEMEN.forEach(t=>byT[t.k]=shuffle(FRAGEN.filter(f=>f.t===t.k)));
  const order=shuffle(THEMEN.map(t=>t.k));
  const picked=[]; let total=0,i=0,guard=0;
  while(total<EXAM_TARGET && guard<1000){
    const k=order[i%order.length];
    if(byT[k].length){const q=byT[k].shift(); picked.push(q); total+=q.p;}
    i++; guard++;
    if(order.every(k=>byT[k].length===0)) break;
  }
  return {qs:shuffle(picked),total,answers:{},idx:0,start:Date.now(),done:false};
}
function renderPruefStart(){
  app.innerHTML=`
    <p class="eyebrow">02 · Prüfungsmodus — Simulierte Klausur</p>
    <div class="card" style="padding:20px 18px">
      <div class="statgrid" style="margin-bottom:16px">
        <div class="metric"><div class="v mono">80 P</div><div class="l">Gesamtumfang</div></div>
        <div class="metric"><div class="v mono">150:00</div><div class="l">Zeitlimit (min)</div></div>
      </div>
      <p class="muted" style="font-size:13.5px">Zufällige, über alle 14 Themen gleichmäßig verteilte Auswahl. Lösungen erst nach Abgabe. Selbstbewertung am Ende → Punkte, Prozent und Note (1,0–5,0).</p>
      <button class="btn orange" id="startExam" style="width:100%;margin-top:8px;padding:13px">Klausur generieren & starten →</button>
    </div>`;
  $("#startExam").onclick=()=>{exam=genExam();exam.idx=0;startTimer();renderExamQ();};
}
function startTimer(){
  clearInterval(timerId);
  timerId=setInterval(()=>{
    if(!exam||exam.done){clearInterval(timerId);return;}
    const left=EXAM_MIN-Math.floor((Date.now()-exam.start)/1000);
    const el=$("#timer");
    if(el){
      const m=Math.max(0,Math.floor(left/60)),s=Math.max(0,left%60);
      el.textContent=String(m).padStart(2,"0")+":"+String(s).padStart(2,"0");
      el.className="timer"+(left<300?" crit":left<900?" warn":"");
    }
    if(left<=0) finishExam();
  },1000);
}
function renderExamQ(){
  const q=exam.qs[exam.idx], n=exam.qs.length;
  const answered=Object.keys(exam.answers).length;
  app.innerHTML=`
    <div class="spread" style="margin-bottom:10px">
      <span class="timer" id="timer">150:00</span>
      <span class="mono muted">Frage ${exam.idx+1} / ${n} · ${answered} markiert · ${exam.total} P</span>
    </div>
    <div class="pbar" style="margin-bottom:14px"><i style="width:${((exam.idx+1)/n)*100}%"></i></div>
    <div class="card">
      <div class="qhead"><span class="qtag">${tName(q.t)}</span>
        <span><span class="qtyp">${typLabel(q.typ)}</span> &nbsp; <span class="qpts mono">${q.p} P</span></span></div>
      <div class="qbody"><p class="qtext">${esc(q.f)}</p>
        <p class="mono muted" style="font-size:12px">${q.typ==="skizze"?"Skizze auf Papier anfertigen — am Ende selbst bewerten.":"Antwort gedanklich/auf Papier formulieren."}</p>
      </div>
      <div class="qactions">
        <button class="btn ghost" id="prev" ${exam.idx===0?"disabled":""}>← Zurück</button>
        <button class="btn ${exam.idx===n-1?"orange":"primary"}" id="next" style="flex:1">${exam.idx===n-1?"Klausur abgeben":"Weiter →"}</button>
      </div>
    </div>
    <div class="row" style="margin-top:12px">
      <button class="btn ghost" id="abort">Abbrechen</button>
      <button class="btn ghost" id="submitAny" style="margin-left:auto">Jetzt abgeben & auswerten</button>
    </div>`;
  $("#prev").onclick=()=>{if(exam.idx>0){exam.idx--;renderExamQ();}};
  $("#next").onclick=()=>{if(exam.idx<n-1){exam.idx++;renderExamQ();}else finishExam();};
  $("#abort").onclick=()=>{if(confirm("Klausur abbrechen? Fortschritt geht verloren.")){clearInterval(timerId);exam=null;renderPruefStart();}};
  $("#submitAny").onclick=finishExam;
}
function finishExam(){
  clearInterval(timerId); exam.done=true; exam.evalIdx=0; renderExamEval();
}
function renderExamEval(){
  // self-grade each question
  if(exam.evalIdx>=exam.qs.length){ renderExamResult(); return; }
  const q=exam.qs[exam.evalIdx], n=exam.qs.length;
  app.innerHTML=`
    <div class="spread" style="margin-bottom:10px">
      <span class="eyebrow" style="margin:0">Auswertung — selbst bewerten</span>
      <span class="mono muted">${exam.evalIdx+1} / ${n}</span>
    </div>
    <div class="pbar" style="margin-bottom:14px"><i style="width:${((exam.evalIdx+1)/n)*100}%"></i></div>
    <div class="card">
      <div class="qhead"><span class="qtag">${tName(q.t)}</span><span class="qpts mono">${q.p} P</span></div>
      <div class="qbody"><p class="qtext">${esc(q.f)}</p></div>
      <div class="answer"><span class="alabel">Musterlösung</span>${esc(q.a)}</div>
      <div class="qactions">
        <button class="grade g-r" data-g="r">Voll (${q.p} P)</button>
        <button class="grade g-p" data-g="p">Halb (${(q.p/2).toFixed(1)} P)</button>
        <button class="grade g-f" data-g="f">Falsch (0 P)</button>
      </div>
    </div>`;
  app.querySelectorAll(".grade").forEach(b=>b.onclick=()=>{
    const g=b.dataset.g; exam.answers[q.id]=g; recordResult(q.id,g);
    exam.evalIdx++; renderExamEval();
  });
}
function renderExamResult(){
  let score=0; const max=exam.total; const perT={};
  for(const q of exam.qs){
    const g=exam.answers[q.id]||"f";
    const pts=g==="r"?q.p:g==="p"?q.p/2:0;
    score+=pts;
    const t=perT[q.t]||(perT[q.t]={s:0,m:0}); t.s+=pts; t.m+=q.p;
  }
  const pct=max?Math.round(score/max*100):0;
  const note=noteFor(pct);
  const tRows=Object.keys(perT).sort((a,b)=>(perT[a].s/perT[a].m)-(perT[b].s/perT[b].m)).map(k=>{
    const r=perT[k],p=Math.round(r.s/r.m*100),c=p>=70?"var(--green)":p>=50?"var(--amber)":"var(--red)";
    return `<div class="trow"><div><div class="tname">${tName(k)}</div><div class="bar"><i style="width:${p}%;background:${c}"></i></div></div><div class="tpct">${r.s.toFixed(1)}/${r.m} · ${p}%</div></div>`;
  }).join("");
  app.innerHTML=`
    <p class="eyebrow">02 · Klausurergebnis</p>
    <div class="card" style="padding:24px 18px">
      <div class="statgrid">
        <div class="center"><div class="scorebig" style="color:var(--cyan)">${score.toFixed(1)}<span style="font-size:24px;color:var(--dim)">/${max}</span></div><div class="l" style="color:var(--dim);font-size:11px;letter-spacing:1.5px;margin-top:6px">PUNKTE · ${pct}%</div></div>
        <div class="center"><div class="note" style="color:${noteColor(note)}">${note}</div><div class="l" style="color:var(--dim);font-size:11px;letter-spacing:1.5px;margin-top:6px">NOTE</div></div>
      </div>
      <div class="bar" style="height:9px;margin-top:18px"><i style="width:${pct}%;background:${noteColor(note)}"></i></div>
    </div>
    <div class="card" style="padding:16px 18px">
      <p class="eyebrow">Fehlerübersicht nach Thema</p>
      <div class="tlist">${tRows}</div>
    </div>
    <div class="row" style="margin-top:6px">
      <button class="btn primary" id="newExam">Neue Klausur</button>
      <button class="btn" id="toStat2">Gesamtstatistik</button>
    </div>`;
  $("#newExam").onclick=()=>{exam=null;renderPruefStart();};
  $("#toStat2").onclick=()=>{document.querySelector('.tab[data-v="stat"]').click();};
}

/* ---------- Statistik ---------- */
function renderStat(){
  const m=themeStats();
  let totAtt=0,totScore=0,totMax=0;
  const rows=[];
  for(const t of THEMEN){
    const x=m[t.k]; totAtt+=x.att; totScore+=x.score; totMax+=x.max;
    const pct=x.max?Math.round(x.score/x.max*100):null;
    rows.push({k:t.k,n:t.n,att:x.att,pct});
  }
  const overall=totMax?Math.round(totScore/totMax*100):0;
  const done=rows.filter(r=>r.att>0);
  const ranked=done.filter(r=>r.pct!=null).sort((a,b)=>b.pct-a.pct);
  const strong=ranked.slice(0,3), weak=ranked.slice().reverse().slice(0,3);
  const empty=totAtt===0;

  const themeRows=rows.map(r=>{
    const c=r.pct==null?"var(--dim2)":r.pct>=70?"var(--green)":r.pct>=50?"var(--amber)":"var(--red)";
    return `<div class="trow">
      <div><div class="tname">${r.n}</div><div class="bar"><i style="width:${r.pct||0}%;background:${c}"></i></div></div>
      <div class="tpct">${r.att?r.pct+"% · "+r.att+"×":"—"}</div></div>`;
  }).join("");

  app.innerHTML=`
    <p class="eyebrow">03 · Statistik — dauerhaft gespeichert</p>
    ${empty?`<div class="card center" style="padding:40px 20px"><p class="muted">Noch keine Daten. Starte den Lern- oder Prüfungsmodus.</p></div>`:`
    <div class="statgrid" style="margin-bottom:14px">
      <div class="metric"><div class="v mono" style="color:var(--cyan)">${overall}%</div><div class="l">Erfolgsquote gesamt</div></div>
      <div class="metric"><div class="v mono">${totAtt}</div><div class="l">Bearbeitungen</div></div>
    </div>
    <div class="statgrid" style="margin-bottom:14px">
      <div class="metric"><div class="l" style="margin:0 0 10px;color:var(--green)">Stärkste Themen</div>
        ${strong.length?strong.map(r=>`<div class="spread" style="margin-bottom:4px"><span style="font-size:13px">${r.n}</span><span class="mono" style="color:var(--green);font-size:12px">${r.pct}%</span></div>`).join(""):'<span class="muted">—</span>'}</div>
      <div class="metric"><div class="l" style="margin:0 0 10px;color:var(--red)">Schwächste Themen</div>
        ${weak.length?weak.map(r=>`<div class="spread" style="margin-bottom:4px"><span style="font-size:13px">${r.n}</span><span class="mono" style="color:var(--red);font-size:12px">${r.pct}%</span></div>`).join(""):'<span class="muted">—</span>'}</div>
    </div>
    <div class="card" style="padding:14px 16px;margin-bottom:14px">
      <p class="eyebrow">Lernempfehlung</p>
      <p style="margin:0;font-size:14px">${weak.length?`Fokus auf <b style="color:var(--red)">${weak[0].n}</b>${weak[1]?` und <b style="color:var(--amber)">${weak[1].n}</b>`:""}. ${rows.filter(r=>r.att===0).length?`Noch ungeübt: <span class="muted">${rows.filter(r=>r.att===0).map(r=>r.n).join(", ")}</span>.`:"Alle Themen mindestens einmal bearbeitet."}`:"Bearbeite mehr Fragen für eine Empfehlung."}</p>
    </div>
    <div class="card" style="padding:14px 16px">
      <p class="eyebrow">Alle Themen</p>
      <div class="tlist">${themeRows}</div>
    </div>`}
    <div class="row" style="margin-top:14px">
      <button class="btn ghost" id="reset">Statistik zurücksetzen</button>
    </div>`;
  $("#reset").onclick=async()=>{
    if(confirm("Gesamte Statistik löschen?")){STATS={};await saveStats();renderStat();}
  };
}

/* ---------- Router ---------- */
function render(){
  if(VIEW==="lern") renderLern();
  else if(VIEW==="pruef"){ if(exam&&!exam.done) renderExamQ(); else if(exam&&exam.done) renderExamResult(); else renderPruefStart(); }
  else renderStat();
}
(async()=>{ await loadStats(); render(); })();
</script>
