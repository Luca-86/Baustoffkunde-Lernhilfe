<title>O.KON Klausurtrainer · Konstruktion B1</title>
<style>
:root{
  --ink:#0b1622; --panel:#10263b; --panel2:#0e2032; --line:rgba(120,180,230,.16);
  --line2:rgba(120,180,230,.30); --text:#e8eef5; --dim:#8aa6c0; --dim2:#5f7d99;
  --cyan:#4cc9f0; --orange:#ff7a45; --green:#41d39a; --red:#ff5d6c; --amber:#ffc857;
  --mono:ui-monospace,"SFMono-Regular",Menlo,Consolas,monospace;
  --sans:"Helvetica Neue",Arial,system-ui,sans-serif;
}
*{box-sizing:border-box}
html,body{margin:0}
body{
  background:var(--ink);
  background-image:linear-gradient(var(--line) 1px,transparent 1px),linear-gradient(90deg,var(--line) 1px,transparent 1px);
  background-size:26px 26px;
  color:var(--text); font-family:var(--sans); font-size:15px; line-height:1.5;
  -webkit-font-smoothing:antialiased;
}
.wrap{max-width:920px;margin:0 auto;padding:20px 16px 80px}
button{font-family:inherit;cursor:pointer}
.mono{font-family:var(--mono)}

/* header / titleblock */
.tb{border:1px solid var(--line2);background:rgba(16,38,59,.7);backdrop-filter:blur(4px);margin-bottom:18px}
.tb-top{display:flex;justify-content:space-between;align-items:flex-end;gap:12px;padding:14px 16px 10px;border-bottom:1px solid var(--line)}
.tb h1{margin:0;font-size:20px;letter-spacing:.5px;font-weight:800;text-transform:uppercase}
.tb h1 .sub{display:block;font-size:11px;letter-spacing:3px;color:var(--cyan);font-weight:600;margin-bottom:3px}
.tb-meta{font-family:var(--mono);font-size:11px;color:var(--dim);text-align:right;line-height:1.7}
.tb-meta b{color:var(--text)}
.tabs{display:flex}
.tab{flex:1;background:none;border:none;border-right:1px solid var(--line);color:var(--dim);
  padding:11px 8px;font-size:12px;letter-spacing:1.5px;text-transform:uppercase;font-weight:700;transition:.15s}
.tab:last-child{border-right:none}
.tab:hover{color:var(--text);background:rgba(76,201,240,.06)}
.tab.on{color:var(--ink);background:var(--cyan)}

/* generic */
.eyebrow{font-family:var(--mono);font-size:11px;letter-spacing:2px;color:var(--cyan);text-transform:uppercase;margin:0 0 8px}
.card{border:1px solid var(--line2);background:var(--panel);padding:0;margin-bottom:14px}
.btn{background:var(--panel2);border:1px solid var(--line2);color:var(--text);padding:10px 16px;
  font-size:13px;letter-spacing:.5px;font-weight:600;transition:.15s}
.btn:hover{border-color:var(--cyan);color:var(--cyan)}
.btn.primary{background:var(--cyan);color:var(--ink);border-color:var(--cyan)}
.btn.primary:hover{background:#6fd6f5;color:var(--ink)}
.btn.orange{background:var(--orange);color:var(--ink);border-color:var(--orange)}
.btn.ghost{background:none}
.btn:disabled{opacity:.4;cursor:not-allowed}
.row{display:flex;gap:10px;flex-wrap:wrap}
.spread{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}
.muted{color:var(--dim)}
hr.dim{border:none;border-top:1px dashed var(--line2);margin:14px 0}

/* theme chips */
.chips{display:flex;flex-wrap:wrap;gap:8px;margin:12px 0}
.chip{border:1px solid var(--line2);background:var(--panel2);color:var(--dim);padding:7px 12px;
  font-size:12px;font-weight:600;letter-spacing:.3px;border-radius:2px;transition:.12s;display:flex;gap:8px;align-items:center}
.chip:hover{color:var(--text)}
.chip.on{background:rgba(76,201,240,.14);border-color:var(--cyan);color:var(--cyan)}
.chip .ct{font-family:var(--mono);font-size:10px;opacity:.7}

/* question */
.qhead{display:flex;justify-content:space-between;align-items:center;padding:9px 14px;border-bottom:1px solid var(--line);
  font-family:var(--mono);font-size:11px;letter-spacing:1px;color:var(--dim);text-transform:uppercase}
.qtag{color:var(--cyan)}
.qpts{border:1px solid var(--line2);padding:2px 8px;color:var(--amber)}
.qtyp{color:var(--dim2)}
.qbody{padding:16px 16px 4px}
.qtext{font-size:17px;line-height:1.45;margin:0 0 6px;font-weight:500}
.answer{background:var(--panel2);border-top:1px solid var(--line2);padding:14px 16px;white-space:pre-wrap;
  font-size:14.5px;line-height:1.55;color:#dce9f5}
.answer .alabel{font-family:var(--mono);font-size:10px;letter-spacing:2px;color:var(--green);text-transform:uppercase;display:block;margin-bottom:8px}
.skizze-note{font-family:var(--mono);font-size:10px;color:var(--amber);letter-spacing:1px;margin-bottom:6px}
.qactions{padding:12px 16px;display:flex;gap:10px;flex-wrap:wrap;border-top:1px solid var(--line)}
.grade{flex:1;min-width:90px;border:1px solid var(--line2);background:var(--panel2);color:var(--text);padding:10px;
  font-size:12px;font-weight:700;letter-spacing:.5px;transition:.12s}
.grade.g-r:hover,.grade.g-r.sel{background:var(--green);color:var(--ink);border-color:var(--green)}
.grade.g-p:hover,.grade.g-p.sel{background:var(--amber);color:var(--ink);border-color:var(--amber)}
.grade.g-f:hover,.grade.g-f.sel{background:var(--red);color:var(--ink);border-color:var(--red)}

/* progress */
.pbar{height:4px;background:var(--panel2);border:1px solid var(--line);overflow:hidden}
.pbar i{display:block;height:100%;background:var(--cyan);transition:width .3s}
.timer{font-family:var(--mono);font-size:22px;font-weight:700;letter-spacing:1px}
.timer.warn{color:var(--amber)} .timer.crit{color:var(--red)}

/* result */
.scorebig{font-family:var(--mono);font-size:54px;font-weight:800;line-height:1}
.note{font-family:var(--mono);font-size:54px;font-weight:800}
.statgrid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.metric{border:1px solid var(--line2);background:var(--panel);padding:14px}
.metric .v{font-family:var(--mono);font-size:28px;font-weight:800}
.metric .l{font-size:11px;letter-spacing:1.5px;text-transform:uppercase;color:var(--dim);margin-top:4px}
.bar{height:7px;background:var(--panel2);border:1px solid var(--line);margin-top:6px}
.bar i{display:block;height:100%}
.tlist .trow{display:grid;grid-template-columns:1fr auto;gap:6px;align-items:center;padding:9px 0;border-bottom:1px solid var(--line)}
.tlist .trow:last-child{border-bottom:none}
.tname{font-size:13px;font-weight:600}
.tpct{font-family:var(--mono);font-size:12px;color:var(--dim)}
.center{text-align:center}
.hide{display:none}
@media(max-width:560px){
  .statgrid{grid-template-columns:1fr}
  .tb-top{flex-direction:column;align-items:flex-start}
  .tb-meta{text-align:left}
  .scorebig,.note{font-size:42px}
}
</style>
