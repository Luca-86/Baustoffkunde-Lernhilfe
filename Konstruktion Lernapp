/* ---------- Persistenz ---------- */
const SKEY="okon-stats-v1";
let STATS={}; // id -> {r,p,f}
async function loadStats(){
  try{const o=await window.storage.get(SKEY); if(o&&o.value) STATS=JSON.parse(o.value);}catch(e){STATS={};}
}
async function saveStats(){
  try{await window.storage.set(SKEY, JSON.stringify(STATS), false);}catch(e){}
}
function recordResult(id,grade){ // grade: 'r','p','f'
  const s=STATS[id]||(STATS[id]={r:0,p:0,f:0});
  s[grade]=(s[grade]||0)+1; saveStats();
}
function themeStats(){
  const m={}; THEMEN.forEach(t=>m[t.k]={att:0,score:0,max:0});
  for(const f of FRAGEN){
    const s=STATS[f.id]; if(!s) continue;
    const att=s.r+s.p+s.f; if(!att) continue;
    m[f.t].att+=att;
    m[f.t].score+=s.r*1+s.p*0.5;
    m[f.t].max+=att;
  }
  return m;
}

/* ---------- Helfer ---------- */
const $=s=>document.querySelector(s);
const app=$("#app");
const tName=k=>(THEMEN.find(t=>t.k===k)||{}).n||k;
function shuffle(a){a=a.slice();for(let i=a.length-1;i>0;i--){const j=Math.random()*(i+1)|0;[a[i],a[j]]=[a[j],a[i]];}return a;}
function noteFor(p){ // Prozent -> Note
  const t=[[95,"1,0"],[90,"1,3"],[85,"1,7"],[80,"2,0"],[75,"2,3"],[70,"2,7"],[65,"3,0"],[60,"3,3"],[55,"3,7"],[50,"4,0"]];
  for(const[g,n]of t) if(p>=g) return n; return "5,0";
}
function noteColor(n){const v=parseFloat(n.replace(",",".")); return v<=2.0?"var(--green)":v<=3.3?"var(--amber)":"var(--red)";}
function esc(s){return s.replace(/[&<>]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;"}[c]));}
function typLabel(t){return t==="skizze"?"Skizze":t==="calc"?"Rechnung":"Text";}

